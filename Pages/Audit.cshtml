@page
@model AuditModel
@{ ViewData["Title"] = "Audit Log"; }

<div class="page-heading"><div><span class="eyebrow">ACCOUNTABILITY</span><h1>Audit log</h1></div></div>
<section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Record</th></tr></thead><tbody>
@foreach (var log in Model.Logs)
{ <tr><td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@log.Actor</td><td>@log.Action</td><td>@log.Record</td></tr> }
</tbody></table></div></section>
